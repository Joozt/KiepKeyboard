set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(TC_ROOT /opt/toolchain)
set(CMAKE_C_COMPILER ${TC_ROOT}/bin/arm-linux-gnueabihf-gcc)
set(CMAKE_CXX_COMPILER ${TC_ROOT}/bin/arm-linux-gnueabihf-g++)
set(CMAKE_SYSROOT ${TC_ROOT}/arm-linux-gnueabihf/libc)
# Flags the vendor toolchain uses (from the SDK demo's .cproject / Owlanzi toolchain file)
set(CMAKE_C_FLAGS_INIT   "-march=armv7-a -mfpu=neon -mfloat-abi=hard -funsigned-char")
set(CMAKE_CXX_FLAGS_INIT "-march=armv7-a -mfpu=neon -mfloat-abi=hard -funsigned-char")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
