<?xml version="1.0" encoding="utf-8"?>
<!-- Same layering as activity_fullscreen: the root background belongs to
     BatteryStatus (low-battery tint), the flash overlay to the yes/no and
     attention highlights, mirroring the editText background on the phone -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/displayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <View
        android:id="@+id/displayFlash"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Centered like the keyboard's editText; when the text overflows the
         scroll-to-bottom in showText keeps the newest lines visible -->
    <ScrollView
        android:id="@+id/displayScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <TextView
            android:id="@+id/displayText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="@android:color/white" />
    </ScrollView>

    <TextView
        android:id="@+id/displayStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="24dp"
        android:textColor="@android:color/darker_gray"
        android:textSize="16sp" />

    <View
        android:id="@+id/displayHeartbeat"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/indicator_dot"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_gravity="bottom"
        android:elevation="7dp"
        android:progress="0"
        android:progressBackgroundTint="@android:color/transparent"
        android:progressTint="@color/colorAccent"
        android:scaleY="2" />
</FrameLayout>
